{
  "name": "weather_notify_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../weather_notify/openapi.json -o src/lib/api-types.ts",
    "gen:api:ci": "openapi-typescript api-spec/openapi.json -o src/lib/api-types.ts",
    "gen:api:check": "npm run gen:api:ci && git diff --exit-code src/lib/api-types.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.1",
    "axios": "^1.18.1",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": {
      ".": "^8.5.25",
      "nanoid": "^3.3.18"
    },
    "sharp": "^0.35.3",
    "jsdom": {
      "undici": "^7.29.0"
    },
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.1"
    },
    "@redocly/openapi-core": {
      "js-yaml": "^4.3.1"
    }
  }
}
